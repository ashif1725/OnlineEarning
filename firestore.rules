rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    /* =====================================================
       USERS
       ===================================================== */

    match /users/{userId} {

      allow read: if isSignedIn()
                  && request.auth.uid == userId;

      allow create: if isSignedIn()
                    && request.auth.uid == userId;

      /*
       * User apna role/admin status change nahi kar sakta.
       */
      allow update: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role
                       == resource.data.role;

      allow delete: if false;
    }


    /* =====================================================
       COURSES
       ===================================================== */

    match /courses/{courseId} {

      allow read: if true;

      /*
       * Course creation/update/delete admin/backend se.
       */
      allow write: if isAdmin();
    }


    /* =====================================================
       PAYMENTS
       ===================================================== */

    match /payments/{paymentId} {

      allow read: if isSignedIn()
                  && (
                    resource.data.userId
                    == request.auth.uid
                    || isAdmin()
                  );

      /*
       * Payment status ko user khud approve nahi kar sakta.
       */
      allow create: if isSignedIn()
                    && request.resource.data.userId
                       == request.auth.uid;

      allow update, delete: if isAdmin();
    }


    /* =====================================================
       WALLETS
       ===================================================== */

    match /wallets/{userId} {

      /*
       * User sirf apna wallet read kar sakta hai.
       */
      allow read: if isSignedIn()
                  && request.auth.uid == userId;

      /*
       * Balance client-side change nahi ho sakta.
       * Admin/backend hi wallet update kare.
       */
      allow create, update, delete: if isAdmin();
    }


    /* =====================================================
       WALLET TRANSACTIONS
       ===================================================== */

    match /walletTransactions/{transactionId} {

      /*
       * User sirf apni transactions dekh sakta hai.
       */
      allow read: if isSignedIn()
                  && resource.data.userId
                     == request.auth.uid;

      /*
       * Credit/debit transaction client se create/edit/delete
       * nahi ki ja sakti.
       */
      allow create, update, delete: if isAdmin();
    }


    /* =====================================================
       ENROLLMENTS
       ===================================================== */

    match /enrollments/{enrollmentId} {

      allow read: if isSignedIn()
                  && (
                    resource.data.userId
                    == request.auth.uid
                    || isAdmin()
                  );

      allow create, update, delete: if isAdmin();
    }


    /* =====================================================
       PRODUCTS
       ===================================================== */

    match /products/{productId} {

      allow read: if true;

      allow create, update, delete: if isAdmin();
    }


    /* =====================================================
       REFERRALS
       ===================================================== */

    match /referrals/{referralId} {

      allow read: if isSignedIn()
                  && resource.data.userId
                     == request.auth.uid;

      allow create: if isSignedIn()
                    && request.resource.data.userId
                       == request.auth.uid;

      allow update, delete: if isAdmin();
    }


    /* =====================================================
       ADMIN CHECK
       ===================================================== */

    function isSignedIn() {
      return request.auth != null;
    }


    function isAdmin() {

      return isSignedIn()
             && exists(
                  /databases/$(database)/documents/users/$(request.auth.uid)
                )
             && get(
                  /databases/$(database)/documents/users/$(request.auth.uid)
                ).data.role == "admin";
    }

  }
}
