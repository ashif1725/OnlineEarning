rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =========================================================
    // HELPER FUNCTIONS
    // =========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin users should have a Firebase custom claim:
    // { "admin": true }
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.admin == true;
    }


    // =========================================================
    // USERS / PROFILES
    // =========================================================

    match /users/{userId} {

      // User can read only his/her own profile
      // Admin can read all profiles
      allow read: if isOwner(userId) || isAdmin();

      // User can create only his/her own profile
      allow create: if isOwner(userId);

      // User can update only his/her own profile
      // Admin can update any profile
      allow update: if isOwner(userId) || isAdmin();

      // Users should not delete their account data directly
      allow delete: if isAdmin();
    }


    // =========================================================
    // COURSES
    // =========================================================

    match /courses/{courseId} {

      // Courses can be viewed without login
      allow read: if true;

      // Only admin can create/update/delete courses
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // ENROLLMENTS
    // =========================================================

    match /enrollments/{enrollmentId} {

      // Logged-in user can read only his/her enrollment
      // Admin can read everything
      allow read: if isSignedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      // Enrollment must be created only after
      // a VERIFIED payment exists.
      //
      // Expected payment document:
      // payments/{paymentId}
      //
      // status must be "verified"
      //
      // payment userId must match logged-in user.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.courseId is string
        && request.resource.data.paymentId is string
        && exists(
          /databases/$(database)/documents/payments/$(request.resource.data.paymentId)
        )
        && get(
          /databases/$(database)/documents/payments/$(request.resource.data.paymentId)
        ).data.userId == request.auth.uid
        && get(
          /databases/$(database)/documents/payments/$(request.resource.data.paymentId)
        ).data.courseId == request.resource.data.courseId
        && get(
          /databases/$(database)/documents/payments/$(request.resource.data.paymentId)
        ).data.status == "verified";

      // User can update only limited enrollment information.
      // Admin can update everything.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.courseId == resource.data.courseId
          && request.resource.data.paymentId == resource.data.paymentId
        );

      // Only admin can delete enrollments
      allow delete: if isAdmin();
    }


    // =========================================================
    // PAYMENTS
    // =========================================================

    match /payments/{paymentId} {

      // User can see only his/her own payments.
      // Admin can see all payments.
      allow read: if isSignedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      // User can create a NEW pending payment record.
      //
      // IMPORTANT:
      // Client is NOT allowed to create a "verified" payment.
      //
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.courseId is string
        && request.resource.data.amount is number;

      // Only admin/server can change payment status.
      //
      // This prevents a user from changing:
      //
      // pending -> verified
      //
      // from the browser.
      allow update: if isAdmin();

      // Only admin can delete payment records
      allow delete: if isAdmin();
    }


    // =========================================================
    // REFERRALS
    // =========================================================

    match /referrals/{referralId} {

      // Referral owner can see own referrals
      // Admin can see everything
      allow read: if isSignedIn()
        && (
          resource.data.referrerId == request.auth.uid
          || resource.data.referredUserId == request.auth.uid
          || isAdmin()
        );

      // Logged-in users can create referral records
      // only where they are the referrer.
      allow create: if isSignedIn()
        && request.resource.data.referrerId == request.auth.uid;

      // Referral records should be controlled by backend/admin.
      allow update, delete: if isAdmin();
    }


    // =========================================================
    // EARNINGS
    // =========================================================

    match /earnings/{earningId} {

      // User can see only own earnings
      // Admin can see all earnings
      allow read: if isSignedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      // Earnings MUST NOT be created directly by users.
      // Backend / Cloud Functions / Admin creates them.
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // WITHDRAWALS
    // =========================================================

    match /withdrawals/{withdrawalId} {

      // User can view own withdrawal request
      // Admin can view all
      allow read: if isSignedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      // User can create withdrawal request for himself/herself.
      //
      // Initial status must be pending.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;

      // User cannot approve/reject his own withdrawal.
      // Only admin can update.
      allow update: if isAdmin();

      // Only admin can delete.
      allow delete: if isAdmin();
    }


    // =========================================================
    // DIGITAL STORE PRODUCTS
    // =========================================================

    match /products/{productId} {

      // Products can be browsed publicly
      allow read: if true;

      // Only admin can manage products
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // PRODUCT ORDERS
    // =========================================================

    match /orders/{orderId} {

      // User sees own orders
      // Admin sees all
      allow read: if isSignedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      // Logged-in user can create own order
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      // Only admin/backend can modify order status
      allow update, delete: if isAdmin();
    }


    // =========================================================
    // COURSE PROGRESS
    // =========================================================

    match /courseProgress/{progressId} {

      // User can read own progress
      // Admin can read all
      allow read: if isSignedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      // User can create own progress
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      // User can update own progress
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;

      // Admin can delete
      allow delete: if isAdmin();
    }


    // =========================================================
    // CONTACT / SUPPORT MESSAGES
    // =========================================================

    match /supportMessages/{messageId} {

      // Anyone can submit a support/contact message
      allow create: if true;

      // Only admin can read/manage messages
      allow read, update, delete: if isAdmin();
    }


    // =========================================================
    // SITE SETTINGS
    // =========================================================

    match /settings/{settingId} {

      // Public website settings can be read
      allow read: if true;

      // Only admin can change settings
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // NOTIFICATIONS
    // =========================================================

    match /notifications/{notificationId} {

      // User can read own notifications
      // Admin can read all
      allow read: if isSignedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      // Backend/admin creates notifications
      allow create: if isAdmin();

      // User can mark own notification as read
      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // ADMIN LOGS
    // =========================================================

    match /adminLogs/{logId} {

      // Only admin
      allow read, create, update, delete: if isAdmin();
    }


    // =========================================================
    // DEFAULT DENY
    // =========================================================

    // Any collection not explicitly listed above
    // is automatically denied.
  }
}
