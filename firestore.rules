rules_version = '2';

service cloud.firestore {

match /databases/{database}/documents {


    /* =================================================
       USERS
       ================================================= */

    match /users/{userId} {

        /*
         * A signed-in user can read their own profile.
         *
         * Client-side profile creation/update should be
         * kept very limited.
         */

        allow read:
            if request.auth != null
            && request.auth.uid == userId;

        allow create:
            if request.auth != null
            && request.auth.uid == userId
            && request.resource.data.uid == userId
            && request.resource.data.role == "user";

        /*
         * Do not allow users to change sensitive fields
         * such as role/accountStatus from the browser.
         */

        allow update:
            if request.auth != null
            && request.auth.uid == userId
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.accountStatus == resource.data.accountStatus;

        allow delete:
            if false;
    }


    /* =================================================
       WALLETS
       ================================================= */

    match /wallets/{userId} {

        /*
         * User can read their own wallet.
         */

        allow read:
            if request.auth != null
            && request.auth.uid == userId;

        /*
         * NEVER allow customer-side wallet balance changes.
         *
         * Deposits, withdrawals, credits and debits will
         * be processed by trusted server-side logic.
         */

        allow create, update, delete:
            if false;
    }


    /* =================================================
       DEPOSITS
       ================================================= */

    match /deposits/{depositId} {

        allow read:
            if request.auth != null
            && resource.data.userId == request.auth.uid;

        /*
         * User may submit a new deposit request.
         *
         * The request must start as pending.
         */

        allow create:
            if request.auth != null
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.status == "pending"
            && request.resource.data.amount is number
            && request.resource.data.amount > 0;

        /*
         * Customer cannot approve/reject/change an
         * existing deposit.
         */

        allow update, delete:
            if false;
    }


    /* =================================================
       WITHDRAWALS
       ================================================= */

    match /withdrawals/{withdrawalId} {

        allow read:
            if request.auth != null
            && resource.data.userId == request.auth.uid;

        /*
         * Withdrawal request can be created only as
         * pending.
         *
         * Actual balance deduction and approval will be
         * performed server-side.
         */

        allow create:
            if request.auth != null
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.status == "pending"
            && request.resource.data.amount is number
            && request.resource.data.amount > 0;

        allow update, delete:
            if false;
    }


    /* =================================================
       TRANSACTIONS
       ================================================= */

    match /transactions/{transactionId} {

        /*
         * Users can view their own ledger entries.
         */

        allow read:
            if request.auth != null
            && resource.data.userId == request.auth.uid;

        /*
         * Users cannot create fake "approved" transactions,
         * change amounts, or modify ledger history.
         */

        allow create, update, delete:
            if false;
    }


    /* =================================================
       ADMIN CONFIG
       ================================================= */

    match /settings/{settingId} {

        /*
         * Public/customer-readable configuration can be
         * selectively exposed later.
         */

        allow read:
            if request.auth != null;

        /*
         * No client-side modification.
         */

        allow write:
            if false;
    }


    /* =================================================
       DEFAULT DENY
       ================================================= */

    match /{document=**} {

        allow read, write:
            if false;

    }

}

}
